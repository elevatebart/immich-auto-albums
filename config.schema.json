{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immich-auto-albums/config.schema.json",
  "title": "immich-auto-albums config",
  "type": "object",
  "properties": {
    "immich": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Immich base URL, without the /api suffix."
        },
        "outDir": {
          "type": "string",
          "minLength": 1,
          "description": "Where the CLI writes logs and decision CSVs."
        },
        "windowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Rolling window for trips, day trips and gatherings."
        },
        "marker": {
          "type": "string",
          "minLength": 1,
          "description": "Album description prefix. Only albums carrying it are ever touched."
        }
      },
      "required": [
        "url",
        "outDir",
        "windowDays",
        "marker"
      ],
      "additionalProperties": false
    },
    "people": {
      "type": "object",
      "properties": {
        "me": {
          "type": "string",
          "minLength": 1,
          "description": "Immich person name of the library owner."
        },
        "household": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Immich person name."
          },
          "default": [],
          "description": "Never named in a title, and eligible for a person year on a lower photo count."
        },
        "withShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of a trip's face-tagged photos a guest must appear in to be named."
        },
        "withMinTagged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500,
          "description": "Minimum face-tagged photos in a cluster before anyone is named."
        },
        "maxNamed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum guests named in one album title."
        },
        "noPeoplePlaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Place name as it appears in album titles."
          },
          "default": [],
          "description": "Places whose albums never name anyone."
        }
      },
      "required": [
        "me",
        "withShare",
        "withMinTagged",
        "maxNamed"
      ],
      "additionalProperties": false
    },
    "homes": {
      "type": "array",
      "minItems": 1,
      "description": "Homes in chronological order. Each applies until the next one starts.",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
            "description": "First day this home applies."
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude."
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Name for your own reference. Never used in an album title."
          }
        },
        "required": [
          "from",
          "lat",
          "lon"
        ],
        "additionalProperties": false
      }
    },
    "clustering": {
      "type": "object",
      "properties": {
        "homeKm": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 500,
          "description": "Photos within this radius of the current home count as at home."
        },
        "placeKm": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 500,
          "description": "Groups photos around a running centroid before naming a place."
        },
        "mergeLabelKm": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 500,
          "description": "Merges nearby place groups before picking the album name."
        },
        "dominantShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of a trip's GPS photos one place needs to name the album."
        },
        "regionShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share one region needs before the other regions are ignored in the name.",
          "default": 0.8
        },
        "zoneShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of a trip's GPS photos a named zone needs to name the album.",
          "default": 0.6
        },
        "tripGapHours": {
          "type": "number",
          "minimum": 1,
          "maximum": 8760,
          "description": "A gap longer than this starts a new trip."
        },
        "tripMinPhotos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Minimum photos for a trip."
        },
        "tripMinDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Minimum distinct days for a trip. Below this it is considered a day trip."
        },
        "daytripMinPhotos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Minimum photos on the busiest day for a day trip."
        },
        "gatherGapHours": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 168,
          "description": "A gap longer than this starts a new gathering."
        },
        "gatherMinPhotos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Minimum photos for a gathering at home."
        },
        "gatherMinGuests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Minimum named non-household faces for a gathering."
        },
        "eventAbsorbShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of a cluster's photos and of its days inside a hand-declared event before it folds into that event.",
          "default": 0.5
        }
      },
      "required": [
        "homeKm",
        "placeKm",
        "mergeLabelKm",
        "dominantShare",
        "tripGapHours",
        "tripMinPhotos",
        "tripMinDays",
        "daytripMinPhotos",
        "gatherGapHours",
        "gatherMinPhotos",
        "gatherMinGuests"
      ],
      "additionalProperties": false
    },
    "personYears": {
      "type": "object",
      "properties": {
        "minPhotos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "description": "Minimum photos of a person in a year for their album."
        },
        "householdMinPhotos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "description": "Same, for household members."
        }
      },
      "required": [
        "minPhotos",
        "householdMinPhotos"
      ],
      "additionalProperties": false
    },
    "seasons": {
      "type": "object",
      "properties": {
        "noGpsEraEnd": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "description": "Seasonal buckets only cover GPS-less photos before this date."
        },
        "minPhotos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Minimum photos for a seasonal album."
        }
      },
      "required": [
        "noGpsEraEnd",
        "minPhotos"
      ],
      "additionalProperties": false
    },
    "zones": {
      "type": "array",
      "default": [],
      "description": "Named areas that beat the district when a trip mostly happened inside one.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name used in album titles."
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude of the centre."
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude of the centre."
          },
          "km": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 500,
            "description": "Radius around the centre."
          }
        },
        "required": [
          "name",
          "lat",
          "lon",
          "km"
        ],
        "additionalProperties": false
      }
    },
    "naming": {
      "type": "object",
      "properties": {
        "districtCountries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Country name as the geocoder spells it."
          },
          "default": [
            "France"
          ],
          "description": "Countries whose albums are named after the district (admin2) rather than the region."
        },
        "keepRegions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Region name as the geocoder spells it."
          },
          "default": [
            "Normandy",
            "Île-de-France"
          ],
          "description": "Regions that keep naming albums even in a district country."
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {
        "districtCountries": [
          "France"
        ],
        "keepRegions": [
          "Normandy",
          "Île-de-France"
        ]
      }
    },
    "aliases": {
      "type": "object",
      "default": {},
      "description": "Geocoder label to the name used in albums. Applies to cities, districts and states.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Name used in album titles."
      }
    },
    "events": {
      "type": "array",
      "default": [],
      "description": "Hand-declared events. Every photo in the inclusive range joins the album.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Album name, without the date suffix."
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
            "description": "First day, inclusive."
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
            "description": "Last day, inclusive."
          }
        },
        "required": [
          "name",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "immich",
    "people",
    "homes",
    "clustering",
    "personYears",
    "seasons"
  ],
  "additionalProperties": false
}
