# Copy to .env, which is gitignored. Read by the CLI, the UI and the container.
# The API key is only ever here or in the environment, never in config.toml.
# `npm run login -- --save` fills this in for you, and the UI does not need it at all.
IMMICH_API_KEY=
IMMICH_URL=http://localhost:2283

# Optional
# CONFIG=./config.toml
# OUT=.
# WINDOW_DAYS=365
# SCOPE=all              # the CLI plans the whole library instead of the window
# GEOCODER=immich        # keep address lookups off the internet
# ENV_FILE=/data/.env    # where login --save and the UI's Save button write
# DEMO=1                 # UI only: fixture library, no Immich needed
